<Page x:Class="ServiceDesk.Desktop.Views.Pages.MovementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Движение запчастей">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="История движения запчастей" Style="{StaticResource H1}" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <ComboBox x:Name="PartBox" Width="360" Height="38" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="TypeBox" Width="190" Height="38" Margin="12,0,0,0" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
            <TextBlock Text="с" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <DatePicker x:Name="FromBox" Width="130" SelectedDateChanged="Filter_Changed"/>
            <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <DatePicker x:Name="ToBox" Width="130" SelectedDateChanged="Filter_Changed"/>
            <Button Content="Сбросить" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="Reset_Click"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Операция" Binding="{Binding TypeName}" Width="130"/>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="120"/>
                    <DataGridTextColumn Header="Запчасть" Binding="{Binding PartName}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Остаток" Binding="{Binding BalanceAfter}" Width="75"/>
                    <DataGridTextColumn Header="Заявка" Binding="{Binding OrderId}" Width="70"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="1.3*" MinWidth="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock x:Name="Footer" Grid.Row="3" Style="{StaticResource MutedText}" Margin="2,10,0,0"/>
    </Grid>
</Page>
