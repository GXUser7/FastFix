<Page x:Class="ServiceDesk.Desktop.Views.Pages.PartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Остатки">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <TextBlock Text="Номенклатура и остатки" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                <Button Content="Оприходовать" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Receipt_Click"/>
                <Button Content="+ Новая позиция" Margin="10,0,0,0" Click="New_Click"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Grid Width="320">
                <TextBox x:Name="SearchBox" Height="38" TextChanged="Search_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Артикул, наименование или ячейка" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <CheckBox x:Name="BelowMinBox" Content="Только ниже минимального остатка" Margin="16,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="InactiveBox" Content="Показать выведенные" Margin="8,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="Grid" MouseDoubleClick="Edit_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="130"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="Ячейка" Binding="{Binding Location}" Width="80"/>
                    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="На складе" Binding="{Binding OnHand}" Width="90"/>
                    <DataGridTextColumn Header="В резерве" Binding="{Binding Reserved}" Width="90"/>
                    <DataGridTextColumn Header="Доступно" Binding="{Binding Available}" Width="90"/>
                    <DataGridTextColumn Header="Мин." Binding="{Binding MinQuantity}" Width="60"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="50"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BelowMinimum}" Value="True">
                                <Setter Property="Background" Value="#FFF4E0"/>
                                <Setter Property="ToolTip" Value="Доступный остаток ниже неснижаемого — требуется закупка"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="#A0A8B2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
        <TextBlock x:Name="Footer" Grid.Row="3" Style="{StaticResource MutedText}" Margin="2,10,0,0"/>
    </Grid>
</Page>
