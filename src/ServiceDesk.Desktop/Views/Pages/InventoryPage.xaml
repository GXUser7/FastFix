<Page x:Class="ServiceDesk.Desktop.Views.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Инвентаризация">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Инвентаризация" Style="{StaticResource H1}" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="Введите фактический остаток в столбец «Факт». Расхождение рассчитывается автоматически; при проведении учётные остатки корректируются, а операции записываются в журнал движения. Пустое значение — позиция не участвует."/>
                <DataGrid x:Name="Grid" Grid.Row="1" IsReadOnly="False" CellEditEnding="Grid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" MinWidth="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ячейка" Binding="{Binding Location}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Учёт" Binding="{Binding Expected}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Резерв" Binding="{Binding Reserved}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Факт" Binding="{Binding Actual, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Background" Value="#F2F6FD"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Δ" Binding="{Binding DifferenceText}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommentBox" Height="38" ToolTip="Комментарий к инвентаризации"/>
                    <TextBlock x:Name="CommentHint" Text="Комментарий" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button Grid.Column="1" Content="Факт = учёт" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="FillExpected_Click"/>
                    <Button Grid.Column="2" Content="Провести инвентаризацию" Margin="10,0,0,0" Click="Post_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Проведённые инвентаризации" Style="{StaticResource H2}"/>
                <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="History_Selected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="№"/> <Run Text="{Binding Id, Mode=OneWay}"/> <Run Text="от"/> <Run Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                    <Run Text="{Binding CreatedBy, Mode=OneWay}"/> · расхождений: <Run Text="{Binding Discrepancies, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Comment}" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="DetailsText" Grid.Row="2" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
