<Page x:Class="ServiceDesk.Desktop.Views.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="clr-namespace:ServiceDesk.Desktop.Controls"
      Title="Заявки">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <TextBlock x:Name="Header" Text="Заявки" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <Button x:Name="NewButton" Content="+ Оформить заявку" HorizontalAlignment="Right" Height="40" Click="New_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Height="38" TextChanged="Search_Changed" ToolTip="Номер заявки, телефон, фамилия клиента, модель или серийный номер"/>
                <TextBlock x:Name="SearchHint" Text="Поиск по номеру, телефону или фамилии" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="StatusBox" Grid.Column="1" Height="38" Margin="12,0,0,0" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
            <CheckBox x:Name="OverdueBox" Grid.Column="2" Content="Только просроченные" Margin="16,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <Button Grid.Column="3" Content="Обновить" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="Grid" MouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="1.1*" MinWidth="120"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding ClientPhone}" Width="140"/>
                    <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceTitle}" Width="2*" MinWidth="170"/>
                    <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="1*" MinWidth="110"/>
                    <DataGridTextColumn Header="Принята" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTemplateColumn Header="Срок" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DueDate, StringFormat=dd.MM.yyyy}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Статус" Width="1.7*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <c:StatusBadge Text="{Binding StatusName}" Color="{Binding StatusColor}"/>
                                    <c:StatusBadge Text="Просрочена" Color="#C0392B" Margin="6,0,0,0"
                                                   Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}" Width="95"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="Background" Value="#FDF1EF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <TextBlock x:Name="Footer" Grid.Row="3" Style="{StaticResource MutedText}" Margin="2,10,0,0"/>
    </Grid>
</Page>
