<Window x:Class="ServiceDesk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СервисДеск" Width="1366" Height="800" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Style="{StaticResource AppWindow}" Icon="/Assets/logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель: текстовый логотип и пользователь -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource Navy}">
            <Grid Margin="22,0">
                <TextBlock FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="Сервис" Foreground="White"/><Run Text="Деск" Foreground="{StaticResource Accent}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#27AE60" Margin="0,0,8,0" ToolTip="Уведомления в реальном времени"/>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserName" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="UserRole" Foreground="{StaticResource NavMuted}" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Выйти" Style="{StaticResource GhostButton}" Foreground="{StaticResource NavMuted}" Height="34" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Боковое меню строится по роли -->
        <Border Grid.Row="1" Background="{StaticResource Navy}">
            <StackPanel x:Name="Menu" Margin="0,14,0,0"/>
        </Border>

        <Frame x:Name="PageFrame" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden" Background="{StaticResource Bg}"/>
    </Grid>
</Window>
