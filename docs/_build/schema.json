 "checks": [
  {
   "name": "ck_ii_actual",
   "table": "inventory_items",
   "clause": "(`actual_qty` >= 0)"
  },
  {
   "name": "ck_ow_price",
   "table": "order_works",
   "clause": "(`price` >= 0)"
  },
  {
   "name": "ck_orders_total",
   "table": "orders",
   "clause": "(`total_cost` >= 0)"
  },
  {
   "name": "ck_orders_warranty",
   "table": "orders",
   "clause": "((`warranty_months` is null) or (`warranty_months` between 0 and 36))"
  },
  {
   "name": "ck_pr_qty",
   "table": "part_reservations",
   "clause": "(`quantity` > 0)"
  },
  {
   "name": "ck_parts_qty",
   "table": "parts",
   "clause": "(`quantity_on_hand` >= 0)"
  },
  {
   "name": "ck_parts_reserved",
   "table": "parts",
   "clause": "((`quantity_reserved` >= 0) and (`quantity_reserved` <= `quantity_on_hand`))"
  },
  {
   "name": "ck_parts_price",
   "table": "parts",
   "clause": "(`price` >= 0)"
  },
  {
   "name": "ck_pay_amount",
   "table": "payments",
   "clause": "(`amount` > 0)"
  },
  {
   "name": "ck_services_price",
   "table": "services",
   "clause": "(`price` >= 0)"
  },
  {
   "name": "ck_users_failed",
   "table": "users",
   "clause": "(`failed_login_count` >= 0)"
  }
 ],
